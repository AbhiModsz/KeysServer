<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Server Sleeping</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Segoe UI', sans-serif;
    overflow: hidden;
    background: linear-gradient(-45deg, #ff0080, #7928ca, #2af598, #009efd);
    background-size: 400% 400%;
    animation: gradientBG 10s ease infinite;
    position: relative;
  }

  @keyframes gradientBG {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    background-image:
      radial-gradient(2px 2px at 20px 30px, white, transparent),
      radial-gradient(2px 2px at 60px 70px, white, transparent),
      radial-gradient(1.5px 1.5px at 90px 40px, white, transparent),
      radial-gradient(1.5px 1.5px at 130px 80px, white, transparent),
      radial-gradient(2px 2px at 160px 120px, white, transparent),
      radial-gradient(1.5px 1.5px at 200px 20px, white, transparent);

    background-repeat: repeat;
    background-size: 220px 150px;
    opacity: 0.5;
    animation: twinkle 3s ease-in-out infinite alternate;
  }

  @keyframes twinkle {
    from {
      opacity: 0.2;
    }

    to {
      opacity: 0.7;
    }
  }

  .card {
    position: relative;
    z-index: 2;
    background: rgba(15, 10, 35, 0.55);
    backdrop-filter: blur(14px);
    border-radius: 24px;
    padding: 50px 40px;
    text-align: center;
    box-shadow: 0 0 60px rgba(255, 0, 128, 0.4);
    border: 2px solid rgba(255, 255, 255, 0.15);
    max-width: 90%;
    width: 420px;
    animation: floatCard 4s ease-in-out infinite;
  }

  @keyframes floatCard {
    0%, 100% {
      transform: translateY(0px);
    }

    50% {
      transform: translateY(-14px);
    }
  }

  .logo {
    font-size: 34px;
    font-weight: 900;
    letter-spacing: 3px;

    background: linear-gradient(
      90deg,
      #ff0080,
      #ffdd00,
      #00ffea,
      #ff0080
    );

    background-size: 300% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;

    animation: shine 3s linear infinite;
    margin-bottom: 10px;
  }

  @keyframes shine {
    to {
      background-position: 300% center;
    }
  }

  .emoji {
    font-size: 70px;
    display: inline-block;
    animation: sleepBounce 2s ease-in-out infinite;
    margin: 15px 0;
  }

  @keyframes sleepBounce {
    0%, 100% {
      transform: rotate(-8deg) scale(1);
    }

    50% {
      transform: rotate(8deg) scale(1.08);
    }
  }

  .zzz {
    position: relative;
    height: 40px;
  }

  .zzz span {
    position: absolute;
    font-weight: bold;
    color: #fff;
    opacity: 0;

    animation: floatZ 2.4s ease-in infinite;

    text-shadow: 0 0 10px #00ffea;
  }

  .zzz span:nth-child(1) {
    left: 45%;
    font-size: 18px;
    animation-delay: 0s;
  }

  .zzz span:nth-child(2) {
    left: 52%;
    font-size: 24px;
    animation-delay: 0.5s;
  }

  .zzz span:nth-child(3) {
    left: 60%;
    font-size: 30px;
    animation-delay: 1s;
  }

  @keyframes floatZ {
    0% {
      opacity: 0;
      transform: translateY(0) translateX(0) rotate(0deg);
    }

    20% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateY(-60px) translateX(20px) rotate(20deg);
    }
  }

  .status-title {
    font-size: 26px;
    font-weight: 800;
    color: #fff;
    margin-top: 10px;
    text-shadow: 0 0 15px #ff0080;
  }

  .status-sub {
    margin-top: 10px;
    font-size: 15px;
    color: #d9d9ff;
    line-height: 1.5;
  }

  .dot {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ffb300;
    margin-right: 8px;
    box-shadow: 0 0 12px #ffb300;

    animation: pulse 1.4s ease-in-out infinite;
    vertical-align: middle;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 1;
    }

    50% {
      transform: scale(1.4);
      opacity: 0.5;
    }
  }

  .badge {
    margin-top: 25px;
    display: inline-block;
    padding: 10px 22px;
    border-radius: 999px;

    background: linear-gradient(
      90deg,
      #ff0080,
      #7928ca
    );

    color: #fff;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1px;

    box-shadow: 0 0 20px rgba(255, 0, 128, 0.6);
  }

  .footer {
    margin-top: 22px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 1px;
  }

  /* Mobile Responsive */
  @media (max-width: 480px) {
    .card {
      width: 90%;
      padding: 40px 25px;
    }

    .logo {
      font-size: 30px;
    }

    .emoji {
      font-size: 60px;
    }

    .status-title {
      font-size: 22px;
    }

    .status-sub {
      font-size: 14px;
    }
  }
</style>
</head>

<body>

  <div class="stars"></div>

  <div class="card">

    <div class="logo">AbhiModszYT</div>

    <div class="emoji">😴</div>

    <div class="zzz">
      <span>Z</span>
      <span>Z</span>
      <span>Z</span>
    </div>

    <div class="status-title">
      Mod Menu Server Sleeping
    </div>

    <div class="status-sub">
      <span class="dot"></span>
      The server is currently offline / in idle mode.<br>
      
    </div>

    <div class="badge">
      STATUS: SLEEPING
    </div>

    <div class="footer">
      AbhiModszYT • © 2026
    </div>

  </div>

</body>
</html>
